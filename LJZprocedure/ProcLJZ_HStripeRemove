Function/S LJZ_HStripe_ListWaves_OneDF(dfStr)
    String dfStr

    String out
    Variable iObj
    Variable nObj

    out = ""
    nObj = CountObjects(dfStr, 1)

    for (iObj = 0; iObj < nObj; iObj += 1)
        String nm = GetIndexedObjName(dfStr, 1, iObj)
        Wave/Z w = $(dfStr + nm)

        if (!LJZ_HStripe_Is2DOr3DNumericWave(w))
            continue
        endif

        out = AddListItem(dfStr + nm, out, ";", Inf)
    endfor

    return out
End

Function/S LJZ_HStripe_ListWaves(dfStr, recursive)
    String dfStr
    Variable recursive

    String out
    String sub
    Variable iObj
    Variable nObj

    dfStr = LJZ_HStripe_df_with_colon(dfStr)
    if (!DataFolderExists(dfStr))
        return ""
    endif

    out = LJZ_HStripe_ListWaves_OneDF(dfStr)

    if (!recursive)
        return out
    endif

    nObj = CountObjects(dfStr, 4)
    for (iObj = 0; iObj < nObj; iObj += 1)
        sub = GetIndexedObjName(dfStr, 4, iObj)
        if (strlen(sub) == 0)
            continue
        endif

        out += LJZ_HStripe_ListWaves(dfStr + sub + ":", 1)
    endfor

    return out
End

Function/S LJZ_HStripe_CurrentWaveList()
    SVAR sDF = $(LJZ_HStripe_BaseDF() + ":SourceDF")
    NVAR recursive = $(LJZ_HStripe_BaseDF() + ":Recursive")

    return LJZ_HStripe_ListWaves(LJZ_HStripe_df_with_colon(sDF), recursive)
End

Function LJZ_HStripe_RebuildWaveList()
    LJZ_HStripe_EnsureDF()

    SVAR sDF = $(LJZ_HStripe_BaseDF() + ":SourceDF")
    SVAR sWave = $(LJZ_HStripe_BaseDF() + ":WaveSel")
    NVAR SelRow = $(LJZ_HStripe_BaseDF() + ":SelRow")

    String dfStr
    String listStr
    String prevWave
    Variable n
    Variable i
    Variable keepRow

    dfStr = LJZ_HStripe_df_with_colon(sDF)

    Wave/T/Z wDisp = $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    if (!WaveExists(wDisp))
        Make/O/T/N=0 $(LJZ_HStripe_BaseDF() + ":LB_Disp")
        Wave/T wDisp = $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    endif

    Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")
    if (!WaveExists(wSel))
        Make/O/N=0 $(LJZ_HStripe_BaseDF() + ":LB_Sel")
        Wave wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")
    endif

    if (!DataFolderExists(dfStr))
        Redimension/N=0 wDisp
        Redimension/N=0 wSel
        sWave = ""
        SelRow = -1
        LJZ_HStripe_RebindListBox()
        return -1
    endif

    prevWave = sWave
    listStr = LJZ_HStripe_CurrentWaveList()
    n = ItemsInList(listStr, ";")

    // Do not recreate listWave / selWave after the panel has been bound to them.
    // Redimension keeps the wave identity stable and avoids the red-X/empty ListBox issue.
    Redimension/N=(n) wDisp
    Redimension/N=(n) wSel

    wSel = 0

    for (i = 0; i < n; i += 1)
        String wPath = StringFromList(i, listStr, ";")
        Wave/Z w = $wPath

        if (WaveExists(w))
            wDisp[i] = NameOfWave(w)
        else
            wDisp[i] = "(missing)"
        endif
    endfor

    keepRow = WhichListItem(prevWave, listStr, ";", 0, 0)

    if (keepRow < 0)
        keepRow = SelRow
    endif

    if (keepRow < 0)
        keepRow = 0
    endif

    if (n > 0)
        keepRow = max(0, min(n - 1, keepRow))
        wSel[keepRow] = 1
        sWave = StringFromList(keepRow, listStr, ";")
        SelRow = keepRow
    else
        sWave = ""
        SelRow = -1
    endif

    LJZ_HStripe_RebindListBox()
    LJZ_HStripe_RefreshTitleBoxes()

    return 0
End


Function LJZ_HStripe_RebindListBox()
    String pName

    pName = LJZ_HStripe_PanelName()

    DoWindow $pName
    if (!V_flag)
        return 0
    endif

    Wave/T/Z wDisp = $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")

    if (!WaveExists(wDisp))
        return -1
    endif

    if (!WaveExists(wSel))
        return -1
    endif

    if (numpnts(wSel) != numpnts(wDisp))
        Redimension/N=(numpnts(wDisp)) wSel
        wSel = 0
    endif

    ListBox lbWave, win=$pName, listWave=wDisp
    ListBox lbWave, win=$pName, selWave=wSel
    ListBox lbWave, win=$pName, mode=1

    return 0
End


Function LJZ_HStripe_RestoreListSelection()
    LJZ_HStripe_EnsureDF()

    NVAR SelRow = $(LJZ_HStripe_BaseDF() + ":SelRow")

    Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")
    if (!WaveExists(wSel))
        return -1
    endif

    if (numpnts(wSel) <= 0)
        return -1
    endif

    wSel = 0

    if (SelRow >= 0 && SelRow < numpnts(wSel))
        wSel[SelRow] = 1
    endif

    return 0
End

Function LJZ_HStripe_SelectWaveRow(row)
    Variable row

    String listStr
    Variable n

    LJZ_HStripe_EnsureDF()

    listStr = LJZ_HStripe_CurrentWaveList()
    n = ItemsInList(listStr, ";")

    if (n <= 0)
        return -1
    endif

    row = max(0, min(n - 1, row))

    Wave/T/Z wDisp = $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")

    if (!WaveExists(wDisp))
        return -1
    endif

    if (!WaveExists(wSel))
        return -1
    endif

    if (numpnts(wDisp) != n)
        LJZ_HStripe_RebuildWaveList()
        Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")
    endif

    if (numpnts(wSel) != n)
        Redimension/N=(n) wSel
    endif

    wSel = 0
    wSel[row] = 1

    SVAR sWave = $(LJZ_HStripe_BaseDF() + ":WaveSel")
    NVAR SelRow = $(LJZ_HStripe_BaseDF() + ":SelRow")

    sWave = StringFromList(row, listStr, ";")
    SelRow = row

    LJZ_HStripe_RefreshTitleBoxes()

    return 0
End


