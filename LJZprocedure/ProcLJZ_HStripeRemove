Function LJZ_HStripe_SetVarProc(sva) : SetVariableControl
    STRUCT WMSetVariableAction &sva

    if (sva.eventCode != 1 && sva.eventCode != 2 && sva.eventCode != 3)
        return 0
    endif

    if (CmpStr(sva.ctrlName, "svSourceDF") == 0)
        LJZ_HStripe_RebuildWaveList()
        LJZ_HStripe_RefreshTitleBoxes()
    endif

    return 0
End

Function LJZ_HStripe_ButtonProc(ba) : ButtonControl
    STRUCT WMButtonAction &ba

    if (ba.eventCode != 2)
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btScan") == 0)
        LJZ_HStripe_RebuildWaveList()
        LJZ_HStripe_RefreshTitleBoxes()
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btRunSel") == 0)
        LJZ_HStripe_ProcessSelected()
        LJZ_HStripe_RefreshTitleBoxes()
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btRunAll") == 0)
        LJZ_HStripe_ProcessAll()
        LJZ_HStripe_RefreshTitleBoxes()
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btShow") == 0)
        LJZ_HStripe_ShowCheckGraphs()
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btDefaults") == 0)
        LJZ_HStripe_ResetDefaults2()
        return 0
    endif

    if (CmpStr(ba.ctrlName, "btClose") == 0)
        DoWindow/K $(LJZ_HStripe_PanelName())
        return 0
    endif

    return 0
End

Function LJZ_HStripe_ListBoxProc(ctrlName, row, col, eventCode) : ListBoxControl
    String ctrlName
    Variable row
    Variable col
    Variable eventCode

    // The ListBox must only update the selection.
    // It must never run stripe correction.
    // Clicking empty space can clear selWave; restore the old selection in that case.

    if (eventCode != 1 && eventCode != 3 && eventCode != 4 && eventCode != 5)
        return 0
    endif

    if (row < 0)
        LJZ_HStripe_RestoreListSelection()
        return 0
    endif

    LJZ_HStripe_SelectWaveRow(row)

    return 0
End
