Function LJZ_HStripe_GetPointRange(w, axis, x1, x2, pLoOut, pHiOut)
    Wave w
    Variable axis
    Variable x1
    Variable x2
    Variable &pLoOut
    Variable &pHiOut

    Variable n
    Variable p1
    Variable p2
    Variable offset
    Variable delta

    n = DimSize(w, axis)
    if (n < 2)
        pLoOut = 0
        pHiOut = n - 1
        return -1
    endif

    offset = DimOffset(w, axis)
    delta = DimDelta(w, axis)

    if (numtype(x1) != 0 || numtype(x2) != 0 || delta == 0)
        pLoOut = 0
        pHiOut = n - 1
        return 0
    endif

    p1 = round((x1 - offset) / delta)
    p2 = round((x2 - offset) / delta)

    p1 = max(0, min(n - 1, p1))
    p2 = max(0, min(n - 1, p2))

    pLoOut = min(p1, p2)
    pHiOut = max(p1, p2)

    if (pHiOut <= pLoOut)
        pLoOut = 0
        pHiOut = n - 1
    endif

    return 0
End

Function LJZ_HStripe_SetProfileScale(profile, src, stripeAxis)
    Wave profile
    Wave src
    Variable stripeAxis

    if (stripeAxis == 0)
        SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), profile
    else
        SetScale/P x, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), profile
    endif

    return 0
End

Function LJZ_HStripe_CleanAndLimitCorrection(corr, corrMin, corrMax)
    Wave corr
    Variable corrMin
    Variable corrMax

    Variable i
    Variable n
    Variable v

    n = numpnts(corr)
    if (corrMin <= 0 || numtype(corrMin) != 0)
        corrMin = 0.1
    endif
    if (corrMax <= corrMin || numtype(corrMax) != 0)
        corrMax = 10
    endif

    for (i = 0; i < n; i += 1)
        v = corr[i]
        if (numtype(v) != 0)
            v = 1
        endif
        if (abs(v) < 1e-12)
            v = 1
        endif
        if (v < corrMin)
            v = corrMin
        endif
        if (v > corrMax)
            v = corrMax
        endif
        corr[i] = v
    endfor

    return 0
End

Function LJZ_HStripe_LimitStripe(stripe, stripeLimitFactor)
    Wave stripe
    Variable stripeLimitFactor

    Variable limitVal
    Variable i
    Variable n
    Variable v

    if (stripeLimitFactor <= 0 || numtype(stripeLimitFactor) != 0)
        return 0
    endif

    WaveStats/Q stripe
    limitVal = stripeLimitFactor * V_sdev

    if (numtype(limitVal) != 0 || limitVal <= 0)
        return 0
    endif

    n = numpnts(stripe)

    for (i = 0; i < n; i += 1)
        v = stripe[i]
        if (numtype(v) != 0)
            v = 0
        endif
        if (v > limitVal)
            v = limitVal
        endif
        if (v < -limitVal)
            v = -limitVal
        endif
        stripe[i] = v
    endfor

    return 0
End

Function LJZ_HStripe_FillBoundary(profile, pStart, pEnd)
    Wave profile
    Variable pStart
    Variable pEnd

    Variable n

    n = numpnts(profile)

    if (n <= 0)
        return -1
    endif

    pStart = max(0, min(n - 1, round(pStart)))
    pEnd = max(0, min(n - 1, round(pEnd)))

    if (pEnd < pStart)
        Variable tmpP
        tmpP = pStart
        pStart = pEnd
        pEnd = tmpP
    endif

    if (pStart > 0)
        profile[0, pStart - 1] = profile[pStart]
    endif

    if (pEnd < n - 1)
        profile[pEnd + 1, n - 1] = profile[pEnd]
    endif

    return 0
End

Function LJZ_HStripe_MakeProfileFromLayer(src, profile, layer, stripeAxis, avgLo, avgHi)
    Wave src
    Wave profile
    Variable layer
    Variable stripeAxis
    Variable avgLo
    Variable avgHi

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable count
    Variable sumVal
    Variable v
    Variable is3D

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)
    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    if (stripeAxis == 0)
        Redimension/N=(n0) profile
        LJZ_HStripe_SetProfileScale(profile, src, 0)

        avgLo = max(0, min(n1 - 1, round(avgLo)))
        avgHi = max(0, min(n1 - 1, round(avgHi)))
        if (avgHi < avgLo)
            Variable tmpA0
            tmpA0 = avgLo
            avgLo = avgHi
            avgHi = tmpA0
        endif

        for (i = 0; i < n0; i += 1)
            sumVal = 0
            count = 0

            for (j = avgLo; j <= avgHi; j += 1)
                if (is3D)
                    v = src[i][j][layer]
                else
                    v = src[i][j]
                endif

                if (numtype(v) == 0)
                    sumVal += v
                    count += 1
                endif
            endfor

            if (count > 0)
                profile[i] = sumVal / count
            else
                profile[i] = NaN
            endif
        endfor
    else
        Redimension/N=(n1) profile
        LJZ_HStripe_SetProfileScale(profile, src, 1)

        avgLo = max(0, min(n0 - 1, round(avgLo)))
        avgHi = max(0, min(n0 - 1, round(avgHi)))
        if (avgHi < avgLo)
            Variable tmpA1
            tmpA1 = avgLo
            avgLo = avgHi
            avgHi = tmpA1
        endif

        for (j = 0; j < n1; j += 1)
            sumVal = 0
            count = 0

            for (i = avgLo; i <= avgHi; i += 1)
                if (is3D)
                    v = src[i][j][layer]
                else
                    v = src[i][j]
                endif

                if (numtype(v) == 0)
                    sumVal += v
                    count += 1
                endif
            endfor

            if (count > 0)
                profile[j] = sumVal / count
            else
                profile[j] = NaN
            endif
        endfor
    endif

    return 0
End

Function LJZ_HStripe_ApplyProfileCorrection(src, dest, layer, stripeAxis, mode, corr, stripe, power, effLo, effHi)
    Wave src
    Wave dest
    Variable layer
    Variable stripeAxis
    Variable mode
    Wave corr
    Wave stripe
    Variable power
    Variable effLo
    Variable effHi

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable v
    Variable c
    Variable s
    Variable is3D
    Variable inRange

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)

    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    if (power <= 0 || numtype(power) != 0)
        power = 0.5
    endif

    if (stripeAxis == 0)
        effLo = max(0, min(n0 - 1, round(effLo)))
        effHi = max(0, min(n0 - 1, round(effHi)))
    else
        effLo = max(0, min(n1 - 1, round(effLo)))
        effHi = max(0, min(n1 - 1, round(effHi)))
    endif

    if (effHi < effLo)
        Variable tmpP
        tmpP = effLo
        effLo = effHi
        effHi = tmpP
    endif

    for (i = 0; i < n0; i += 1)
        for (j = 0; j < n1; j += 1)
            if (is3D)
                v = src[i][j][layer]
            else
                v = src[i][j]
            endif

            if (stripeAxis == 0)
                c = corr[i]
                s = stripe[i]
                inRange = (i >= effLo && i <= effHi)
            else
                c = corr[j]
                s = stripe[j]
                inRange = (j >= effLo && j <= effHi)
            endif

            if (!inRange)
                if (is3D)
                    dest[i][j][layer] = v
                else
                    dest[i][j] = v
                endif
                continue
            endif

            if (mode == 1)
                v = v - s
            elseif (mode == 2)
                if (numtype(c) == 0 && abs(c) > 1e-12)
                    v = v / c
                endif
            elseif (mode == 3)
                if (numtype(c) == 0 && abs(c) > 1e-12)
                    v = v / (c ^ power)
                endif
            endif

            if (is3D)
                dest[i][j][layer] = v
            else
                dest[i][j] = v
            endif
        endfor
    endfor

    return 0
End

Function LJZ_HStripe_ApplyLineHighpass(src, dest, layer, stripeAxis, effLo, effHi, lineSmoothPts)
    Wave src
    Wave dest
    Variable layer
    Variable stripeAxis
    Variable effLo
    Variable effHi
    Variable lineSmoothPts

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable count
    Variable is3D
    Variable v

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)

    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    lineSmoothPts = round(lineSmoothPts)
    if (lineSmoothPts < 3)
        lineSmoothPts = 3
    endif

    if (stripeAxis == 0)
        effLo = max(0, min(n0 - 1, round(effLo)))
        effHi = max(0, min(n0 - 1, round(effHi)))

        if (effHi < effLo)
            Variable tmp0
            tmp0 = effLo
            effLo = effHi
            effHi = tmp0
        endif

        Make/FREE/D/N=(n1) line, lineLow, lowRef
        lowRef = 0
        count = 0

        for (i = effLo; i <= effHi; i += 1)
            for (j = 0; j < n1; j += 1)
                if (is3D)
                    line[j] = src[i][j][layer]
                else
                    line[j] = src[i][j]
                endif
            endfor

            Duplicate/O/FREE line, lineLow
            Smooth lineSmoothPts, lineLow
            lowRef += lineLow
            count += 1
        endfor

        if (count > 0)
            lowRef /= count
        endif

        for (i = 0; i < n0; i += 1)
            for (j = 0; j < n1; j += 1)
                if (is3D)
                    line[j] = src[i][j][layer]
                else
                    line[j] = src[i][j]
                endif
            endfor

            Duplicate/O/FREE line, lineLow
            Smooth lineSmoothPts, lineLow

            for (j = 0; j < n1; j += 1)
                if (i >= effLo && i <= effHi)
                    v = line[j] - lineLow[j] + lowRef[j]
                else
                    v = line[j]
                endif

                if (is3D)
                    dest[i][j][layer] = v
                else
                    dest[i][j] = v
                endif
            endfor
        endfor
    else
        effLo = max(0, min(n1 - 1, round(effLo)))
        effHi = max(0, min(n1 - 1, round(effHi)))

        if (effHi < effLo)
            Variable tmp1
            tmp1 = effLo
            effLo = effHi
            effHi = tmp1
        endif

        Make/FREE/D/N=(n0) line2, lineLow2, lowRef2
        lowRef2 = 0
        count = 0

        for (j = effLo; j <= effHi; j += 1)
            for (i = 0; i < n0; i += 1)
                if (is3D)
                    line2[i] = src[i][j][layer]
                else
                    line2[i] = src[i][j]
                endif
            endfor

            Duplicate/O/FREE line2, lineLow2
            Smooth lineSmoothPts, lineLow2
            lowRef2 += lineLow2
            count += 1
        endfor

        if (count > 0)
            lowRef2 /= count
        endif

        for (j = 0; j < n1; j += 1)
            for (i = 0; i < n0; i += 1)
                if (is3D)
                    line2[i] = src[i][j][layer]
                else
                    line2[i] = src[i][j]
                endif
            endfor

            Duplicate/O/FREE line2, lineLow2
            Smooth lineSmoothPts, lineLow2

            for (i = 0; i < n0; i += 1)
                if (j >= effLo && j <= effHi)
                    v = line2[i] - lineLow2[i] + lowRef2[i]
                else
                    v = line2[i]
                endif

                if (is3D)
                    dest[i][j][layer] = v
                else
                    dest[i][j] = v
                endif
            endfor
        endfor
    endif

    return 0
End

Function LJZ_HStripe_MakeLastLayerImages(src, dest, layer)
    Wave src
    Wave dest
    Variable layer

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable is3D

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)
    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    Make/O/D/N=(n0,n1) $(LJZ_HStripe_BaseDF() + ":LastRaw2D")
    Make/O/D/N=(n0,n1) $(LJZ_HStripe_BaseDF() + ":LastCorrected2D")

    Wave raw2D = $(LJZ_HStripe_BaseDF() + ":LastRaw2D")
    Wave cor2D = $(LJZ_HStripe_BaseDF() + ":LastCorrected2D")

    SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), raw2D, cor2D
    SetScale/P y, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), raw2D, cor2D

    for (i = 0; i < n0; i += 1)
        for (j = 0; j < n1; j += 1)
            if (is3D)
                raw2D[i][j] = src[i][j][layer]
                cor2D[i][j] = dest[i][j][layer]
            else
                raw2D[i][j] = src[i][j]
                cor2D[i][j] = dest[i][j]
            endif
        endfor
    endfor

    return 0
End


Function LJZ_HStripe_ClampValue(v, limitVal)
    Variable v
    Variable limitVal

    if (numtype(v) != 0)
        return 0
    endif

    if (limitVal <= 0 || numtype(limitVal) != 0)
        return v
    endif

    if (v > limitVal)
        return limitVal
    endif

    if (v < -limitVal)
        return -limitVal
    endif

    return v
End


Function LJZ_HStripe_ResidualSDev(stripe, pLo, pHi)
    Wave stripe
    Variable pLo
    Variable pHi

    Variable n
    Variable i
    Variable count
    Variable meanVal
    Variable ss
    Variable v

    n = numpnts(stripe)

    if (n <= 1)
        return 0
    endif

    pLo = round(pLo)
    pHi = round(pHi)

    pLo = max(0, min(n - 1, pLo))
    pHi = max(0, min(n - 1, pHi))

    if (pHi < pLo)
        Variable tmpP
        tmpP = pLo
        pLo = pHi
        pHi = tmpP
    endif

    count = 0
    meanVal = 0

    for (i = pLo; i <= pHi; i += 1)
        v = stripe[i]
        if (numtype(v) == 0)
            meanVal += v
            count += 1
        endif
    endfor

    if (count <= 1)
        return 0
    endif

    meanVal /= count
    ss = 0

    for (i = pLo; i <= pHi; i += 1)
        v = stripe[i]
        if (numtype(v) == 0)
            ss += (v - meanVal) * (v - meanVal)
        endif
    endfor

    return sqrt(ss / (count - 1))
End


Function LJZ_HStripe_NormalizeLayerToRawMean(src, dest, layer)
    Wave src
    Wave dest
    Variable layer

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable is3D
    Variable rawSum
    Variable destSum
    Variable rawCount
    Variable destCount
    Variable rawMean
    Variable destMean
    Variable factor
    Variable vRaw
    Variable vDest

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)

    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    rawSum = 0
    destSum = 0
    rawCount = 0
    destCount = 0

    for (i = 0; i < n0; i += 1)
        for (j = 0; j < n1; j += 1)
            if (is3D)
                vRaw = src[i][j][layer]
                vDest = dest[i][j][layer]
            else
                vRaw = src[i][j]
                vDest = dest[i][j]
            endif

            if (numtype(vRaw) == 0)
                rawSum += vRaw
                rawCount += 1
            endif

            if (numtype(vDest) == 0)
                destSum += vDest
                destCount += 1
            endif
        endfor
    endfor

    if (rawCount <= 0 || destCount <= 0)
        return -1
    endif

    rawMean = rawSum / rawCount
    destMean = destSum / destCount

    if (numtype(rawMean) != 0 || numtype(destMean) != 0)
        return -1
    endif

    if (abs(destMean) < 1e-12)
        return -1
    endif

    factor = rawMean / destMean

    for (i = 0; i < n0; i += 1)
        for (j = 0; j < n1; j += 1)
            if (is3D)
                dest[i][j][layer] *= factor
            else
                dest[i][j] *= factor
            endif
        endfor
    endfor

    return 0
End


Function LJZ_HStripe_SaveMode5Diagnostic(line, low, stripe, corrected)
    Wave line
    Wave low
    Wave stripe
    Wave corrected

    Variable n

    n = numpnts(line)

    Make/O/D/N=(n) $(LJZ_HStripe_BaseDF() + ":LastProfile")
    Make/O/D/N=(n) $(LJZ_HStripe_BaseDF() + ":LastFitProfile")
    Make/O/D/N=(n) $(LJZ_HStripe_BaseDF() + ":LastStripeProfile")
    Make/O/D/N=(n) $(LJZ_HStripe_BaseDF() + ":LastCorrectionProfile")

    Wave lastProfile = $(LJZ_HStripe_BaseDF() + ":LastProfile")
    Wave lastFit = $(LJZ_HStripe_BaseDF() + ":LastFitProfile")
    Wave lastStripe = $(LJZ_HStripe_BaseDF() + ":LastStripeProfile")
    Wave lastCorr = $(LJZ_HStripe_BaseDF() + ":LastCorrectionProfile")

    lastProfile = line[p]
    lastFit = low[p]
    lastStripe = stripe[p]
    lastCorr = corrected[p]

    SetScale/P x, DimOffset(line, 0), DimDelta(line, 0), WaveUnits(line, 0), lastProfile
    SetScale/P x, DimOffset(line, 0), DimDelta(line, 0), WaveUnits(line, 0), lastFit
    SetScale/P x, DimOffset(line, 0), DimDelta(line, 0), WaveUnits(line, 0), lastStripe
    SetScale/P x, DimOffset(line, 0), DimDelta(line, 0), WaveUnits(line, 0), lastCorr

    return 0
End


Function LJZ_HStripe_ApplyMDCWiseCorrection(src, dest, layer, stripeAxis, effLo, effHi, lineSmoothPts, alpha, stripeLimitFactor, layerNormMode)
    Wave src
    Wave dest
    Variable layer
    Variable stripeAxis
    Variable effLo
    Variable effHi
    Variable lineSmoothPts
    Variable alpha
    Variable stripeLimitFactor
    Variable layerNormMode

    Variable n0
    Variable n1
    Variable n2
    Variable i
    Variable j
    Variable is3D
    Variable nLine
    Variable pLo
    Variable pHi
    Variable limitVal
    Variable sdevVal
    Variable v
    Variable cutoff
    Variable diagIndex
    Variable diagDone

    NVAR SmoothCutoff = $(LJZ_HStripe_BaseDF() + ":SmoothCutoff")

    n0 = DimSize(src, 0)
    n1 = DimSize(src, 1)
    n2 = DimSize(src, 2)

    is3D = 0
    if (n2 > 0)
        is3D = 1
    endif

    if (alpha < 0 || numtype(alpha) != 0)
        alpha = 0.35
    endif

    if (alpha > 1)
        alpha = 1
    endif

    lineSmoothPts = round(lineSmoothPts)
    if (lineSmoothPts < 3)
        lineSmoothPts = 3
    endif

    cutoff = SmoothCutoff
    if (numtype(cutoff) != 0 || cutoff <= 0)
        cutoff = 0.25
    endif

    if (cutoff > 0.99)
        cutoff = 0.99
    endif

    if (stripeAxis == 0)
        nLine = n0
    else
        nLine = n1
    endif

    pLo = round(effLo)
    pHi = round(effHi)

    pLo = max(0, min(nLine - 1, pLo))
    pHi = max(0, min(nLine - 1, pHi))

    if (pHi < pLo)
        Variable tmpP
        tmpP = pLo
        pLo = pHi
        pHi = tmpP
    endif

    Make/FREE/D/N=(nLine) line
    Make/FREE/D/N=(nLine) low
    Make/FREE/D/N=(nLine) stripe
    Make/FREE/D/N=(nLine) corrected

    diagDone = 0

    if (stripeAxis == 1)
        diagIndex = round(n0 / 2)
        diagIndex = max(0, min(n0 - 1, diagIndex))

        SetScale/P x, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), line
        SetScale/P x, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), low
        SetScale/P x, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), stripe
        SetScale/P x, DimOffset(src, 1), DimDelta(src, 1), WaveUnits(src, 1), corrected

        for (i = 0; i < n0; i += 1)
            for (j = 0; j < n1; j += 1)
                if (is3D)
                    line[j] = src[i][j][layer]
                else
                    line[j] = src[i][j]
                endif
            endfor

            low = line[p]
            Smooth/BLPF cutoff, low

            stripe = line[p] - low[p]
            sdevVal = LJZ_HStripe_ResidualSDev(stripe, pLo, pHi)
            limitVal = stripeLimitFactor * sdevVal

            for (j = 0; j < n1; j += 1)
                v = line[j]

                if (j >= pLo && j <= pHi)
                    v = line[j] - alpha * LJZ_HStripe_ClampValue(stripe[j], limitVal)
                endif

                corrected[j] = v

                if (is3D)
                    dest[i][j][layer] = v
                else
                    dest[i][j] = v
                endif
            endfor

            if (i == diagIndex)
                LJZ_HStripe_SaveMode5Diagnostic(line, low, stripe, corrected)
                diagDone = 1
            endif
        endfor

        if (!diagDone)
            LJZ_HStripe_SaveMode5Diagnostic(line, low, stripe, corrected)
        endif
    else
        diagIndex = round(n1 / 2)
        diagIndex = max(0, min(n1 - 1, diagIndex))

        SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), line
        SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), low
        SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), stripe
        SetScale/P x, DimOffset(src, 0), DimDelta(src, 0), WaveUnits(src, 0), corrected

        for (j = 0; j < n1; j += 1)
            for (i = 0; i < n0; i += 1)
                if (is3D)
                    line[i] = src[i][j][layer]
                else
                    line[i] = src[i][j]
                endif
            endfor

            low = line[p]
            Smooth/BLPF cutoff, low

            stripe = line[p] - low[p]
            sdevVal = LJZ_HStripe_ResidualSDev(stripe, pLo, pHi)
            limitVal = stripeLimitFactor * sdevVal

            for (i = 0; i < n0; i += 1)
                v = line[i]

                if (i >= pLo && i <= pHi)
                    v = line[i] - alpha * LJZ_HStripe_ClampValue(stripe[i], limitVal)
                endif

                corrected[i] = v

                if (is3D)
                    dest[i][j][layer] = v
                else
                    dest[i][j] = v
                endif
            endfor

            if (j == diagIndex)
                LJZ_HStripe_SaveMode5Diagnostic(line, low, stripe, corrected)
                diagDone = 1
            endif
        endfor

        if (!diagDone)
            LJZ_HStripe_SaveMode5Diagnostic(line, low, stripe, corrected)
        endif
    endif

    if (round(layerNormMode) == 1)
        LJZ_HStripe_NormalizeLayerToRawMean(src, dest, layer)
    endif

    return 0
End



