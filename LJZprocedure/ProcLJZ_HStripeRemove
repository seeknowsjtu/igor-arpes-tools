// ============================================================================
//  LJZ_HStripeRemove : horizontal/line stripe correction for 2D/3D ARPES images
//
//  目的：
//    1) 扫描指定 SourceDF 下的 2D/3D numeric wave
//    2) 对当前 wave 或全部 wave 做横纹/逐行强度校正
//    3) 支持 additive / multiplicative / weak multiplicative / line high-pass reassemble
//    4) 输出 corrected wave，并显示 profile / fit / stripe 检查图
//
//  数据约定：
//    - 2D wave: dim0 × dim1
//    - 3D wave: dim0 × dim1 × stack/layer
//    - StripeAxis = 1: 条纹强度随 dim1 变化；profile 由 dim0 范围平均得到
//    - StripeAxis = 0: 条纹强度随 dim0 变化；profile 由 dim1 范围平均得到
//
//  推荐：
//    - 先用 Mode=1 Additive
//    - StripeAxis 选错时，校正方向会不对；如果横纹没有变好，先换 StripeAxis
// ============================================================================

Menu "ARPES_LJZ"
    "2026HStripeRemove_LJZ", LJZ_HStripeRemove()
End


// ============================================================================
//  Section 0. paths / state
// ============================================================================

Function/S LJZ_HStripe_BaseDF()
    return "root:ARPES_LJZ:HStripeRemove"
End

Function/S LJZ_HStripe_PanelName()
    return "LJZ_HStripeRemove_Panel"
End

Function/S LJZ_HStripe_df_with_colon(inStr)
    String inStr

    String s
    s = inStr

    if (strlen(s) == 0)
        return "root:"
    endif

    if (StringMatch(s, "root"))
        s = "root:"
    endif

    if (!StringMatch(s, "*:"))
        s += ":"
    endif

    return s
End

Function LJZ_HStripe_df_exists(dfStr)
    String dfStr

    String s
    s = LJZ_HStripe_df_with_colon(dfStr)

    return DataFolderExists(s)
End

Function/S LJZ_HStripe_ShortenForTitle(s, maxLen)
    String s
    Variable maxLen

    if (strlen(s) <= maxLen)
        return s
    endif

    return s[0, maxLen - 4] + "..."
End

Function LJZ_HStripe_Is2DOr3DNumericWave(w)
    Wave/Z w

    if (!WaveExists(w))
        return 0
    endif

    if (WaveType(w, 1) != 1)
        return 0
    endif

    if (DimSize(w, 0) <= 0)
        return 0
    endif

    if (DimSize(w, 1) <= 0)
        return 0
    endif

    if (DimSize(w, 3) > 0)
        return 0
    endif

    return 1
End

Function LJZ_HStripe_EnsureDF()
    NewDataFolder/O root:ARPES_LJZ
    NewDataFolder/O $(LJZ_HStripe_BaseDF())

    SVAR/Z sSourceDF = $(LJZ_HStripe_BaseDF() + ":SourceDF")
    if (!SVAR_Exists(sSourceDF))
        String/G $(LJZ_HStripe_BaseDF() + ":SourceDF") = "root:"
    endif

    SVAR/Z sWaveSel = $(LJZ_HStripe_BaseDF() + ":WaveSel")
    if (!SVAR_Exists(sWaveSel))
        String/G $(LJZ_HStripe_BaseDF() + ":WaveSel") = ""
    endif

    SVAR/Z sOutputSuffix = $(LJZ_HStripe_BaseDF() + ":OutputSuffix")
    if (!SVAR_Exists(sOutputSuffix))
        String/G $(LJZ_HStripe_BaseDF() + ":OutputSuffix") = "_hstripe"
    endif

    NVAR/Z SelRow = $(LJZ_HStripe_BaseDF() + ":SelRow")
    if (!NVAR_Exists(SelRow))
        Variable/G $(LJZ_HStripe_BaseDF() + ":SelRow") = -1
    endif

    NVAR/Z Recursive = $(LJZ_HStripe_BaseDF() + ":Recursive")
    if (!NVAR_Exists(Recursive))
        Variable/G $(LJZ_HStripe_BaseDF() + ":Recursive") = 0
    endif

    NVAR/Z StripeAxis = $(LJZ_HStripe_BaseDF() + ":StripeAxis")
    if (!NVAR_Exists(StripeAxis))
        Variable/G $(LJZ_HStripe_BaseDF() + ":StripeAxis") = 1
    endif

    NVAR/Z AvgStart = $(LJZ_HStripe_BaseDF() + ":AvgStart")
    if (!NVAR_Exists(AvgStart))
        Variable/G $(LJZ_HStripe_BaseDF() + ":AvgStart") = NaN
    endif

    NVAR/Z AvgEnd = $(LJZ_HStripe_BaseDF() + ":AvgEnd")
    if (!NVAR_Exists(AvgEnd))
        Variable/G $(LJZ_HStripe_BaseDF() + ":AvgEnd") = NaN
    endif

    NVAR/Z EffStart = $(LJZ_HStripe_BaseDF() + ":EffStart")
    if (!NVAR_Exists(EffStart))
        Variable/G $(LJZ_HStripe_BaseDF() + ":EffStart") = NaN
    endif

    NVAR/Z EffEnd = $(LJZ_HStripe_BaseDF() + ":EffEnd")
    if (!NVAR_Exists(EffEnd))
        Variable/G $(LJZ_HStripe_BaseDF() + ":EffEnd") = NaN
    endif

    NVAR/Z SmoothCutoff = $(LJZ_HStripe_BaseDF() + ":SmoothCutoff")
    if (!NVAR_Exists(SmoothCutoff))
        Variable/G $(LJZ_HStripe_BaseDF() + ":SmoothCutoff") = 0.4
    endif

    NVAR/Z EdgeSmooth = $(LJZ_HStripe_BaseDF() + ":EdgeSmooth")
    if (!NVAR_Exists(EdgeSmooth))
        Variable/G $(LJZ_HStripe_BaseDF() + ":EdgeSmooth") = 0
    endif

    NVAR/Z CorrectionMode = $(LJZ_HStripe_BaseDF() + ":CorrectionMode")
    if (!NVAR_Exists(CorrectionMode))
        Variable/G $(LJZ_HStripe_BaseDF() + ":CorrectionMode") = 1
    endif

    NVAR/Z CorrectionPower = $(LJZ_HStripe_BaseDF() + ":CorrectionPower")
    if (!NVAR_Exists(CorrectionPower))
        Variable/G $(LJZ_HStripe_BaseDF() + ":CorrectionPower") = 0.5
    endif

    NVAR/Z CorrMin = $(LJZ_HStripe_BaseDF() + ":CorrMin")
    if (!NVAR_Exists(CorrMin))
        Variable/G $(LJZ_HStripe_BaseDF() + ":CorrMin") = 0.5
    endif

    NVAR/Z CorrMax = $(LJZ_HStripe_BaseDF() + ":CorrMax")
    if (!NVAR_Exists(CorrMax))
        Variable/G $(LJZ_HStripe_BaseDF() + ":CorrMax") = 2.0
    endif

    NVAR/Z StripeLimitFactor = $(LJZ_HStripe_BaseDF() + ":StripeLimitFactor")
    if (!NVAR_Exists(StripeLimitFactor))
        Variable/G $(LJZ_HStripe_BaseDF() + ":StripeLimitFactor") = 1.0
    endif

    NVAR/Z LineSmoothPts = $(LJZ_HStripe_BaseDF() + ":LineSmoothPts")
    if (!NVAR_Exists(LineSmoothPts))
        Variable/G $(LJZ_HStripe_BaseDF() + ":LineSmoothPts") = 51
    endif

    NVAR/Z MDCAlpha = $(LJZ_HStripe_BaseDF() + ":MDCAlpha")
    if (!NVAR_Exists(MDCAlpha))
        Variable/G $(LJZ_HStripe_BaseDF() + ":MDCAlpha") = 0.35
    endif

    NVAR/Z LayerNormMode = $(LJZ_HStripe_BaseDF() + ":LayerNormMode")
    if (!NVAR_Exists(LayerNormMode))
        Variable/G $(LJZ_HStripe_BaseDF() + ":LayerNormMode") = 1
    endif

    Wave/T/Z wDisp = $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    if (!WaveExists(wDisp))
        Make/O/T/N=0 $(LJZ_HStripe_BaseDF() + ":LB_Disp")
    endif

    Wave/Z wSel = $(LJZ_HStripe_BaseDF() + ":LB_Sel")
    if (!WaveExists(wSel))
        Make/O/N=0 $(LJZ_HStripe_BaseDF() + ":LB_Sel") = 0
    endif

    Make/O/D/N=2 $(LJZ_HStripe_BaseDF() + ":GraphStub") = NaN
    SetScale/P x, 0, 1, "", $(LJZ_HStripe_BaseDF() + ":GraphStub")

    return 0
End


