Function/S LJZ_HStripe_OutputName(srcName, suffix)
    String srcName
    String suffix

    if (strlen(suffix) == 0)
        suffix = "_hstripe"
    endif

    return CleanupName(srcName + suffix, 0)
End

Function LJZ_HStripe_ProcessWave(wPath, showChecks)
    String wPath
    Variable showChecks

    LJZ_HStripe_EnsureDF()

    Wave/Z src = $wPath
    if (!WaveExists(src))
        DoAlert 0, "Selected wave does not exist."
        return -1
    endif

    if (!LJZ_HStripe_Is2DOr3DNumericWave(src))
        DoAlert 0, "Selected wave must be a 2D or 3D numeric wave."
        return -1
    endif

    NVAR StripeAxis = $(LJZ_HStripe_BaseDF() + ":StripeAxis")
    NVAR AvgStart = $(LJZ_HStripe_BaseDF() + ":AvgStart")
    NVAR AvgEnd = $(LJZ_HStripe_BaseDF() + ":AvgEnd")
    NVAR EffStart = $(LJZ_HStripe_BaseDF() + ":EffStart")
    NVAR EffEnd = $(LJZ_HStripe_BaseDF() + ":EffEnd")
    NVAR SmoothCutoff = $(LJZ_HStripe_BaseDF() + ":SmoothCutoff")
    NVAR EdgeSmooth = $(LJZ_HStripe_BaseDF() + ":EdgeSmooth")
    NVAR CorrectionMode = $(LJZ_HStripe_BaseDF() + ":CorrectionMode")
    NVAR CorrectionPower = $(LJZ_HStripe_BaseDF() + ":CorrectionPower")
    NVAR CorrMin = $(LJZ_HStripe_BaseDF() + ":CorrMin")
    NVAR CorrMax = $(LJZ_HStripe_BaseDF() + ":CorrMax")
    NVAR StripeLimitFactor = $(LJZ_HStripe_BaseDF() + ":StripeLimitFactor")
    NVAR LineSmoothPts = $(LJZ_HStripe_BaseDF() + ":LineSmoothPts")
    NVAR MDCAlpha = $(LJZ_HStripe_BaseDF() + ":MDCAlpha")
    NVAR LayerNormMode = $(LJZ_HStripe_BaseDF() + ":LayerNormMode")
    SVAR OutputSuffix = $(LJZ_HStripe_BaseDF() + ":OutputSuffix")

    Variable axis
    Variable avgAxis
    Variable avgLo
    Variable avgHi
    Variable effLo
    Variable effHi
    Variable nLayer
    Variable layer
    Variable mode
    Variable cutoff
    Variable showLayer
    String oldDF
    String outDF
    String outName
    String outPath

    axis = round(StripeAxis)
    if (axis != 0 && axis != 1)
        axis = 1
    endif

    if (axis == 0)
        avgAxis = 1
    else
        avgAxis = 0
    endif

    LJZ_HStripe_GetPointRange(src, avgAxis, AvgStart, AvgEnd, avgLo, avgHi)
    LJZ_HStripe_GetPointRange(src, axis, EffStart, EffEnd, effLo, effHi)

    mode = round(CorrectionMode)
    if (mode < 1 || mode > 5)
        mode = 5
    endif

    cutoff = SmoothCutoff
    if (numtype(cutoff) != 0 || cutoff <= 0)
        cutoff = 0.4
    endif
    if (cutoff > 0.99)
        cutoff = 0.99
    endif

    oldDF = GetDataFolder(1)
    outDF = GetWavesDataFolder(src, 1)
    if (strlen(outDF) == 0)
        outDF = "root:"
    endif

    outName = LJZ_HStripe_OutputName(NameOfWave(src), OutputSuffix)
    outPath = LJZ_HStripe_df_with_colon(outDF) + outName

    Duplicate/O src, $outPath
    Wave dest = $outPath

    nLayer = DimSize(src, 2)
    if (nLayer <= 0)
        nLayer = 1
    endif

    Make/O/D/N=0 $(LJZ_HStripe_BaseDF() + ":LastProfile")
    Make/O/D/N=0 $(LJZ_HStripe_BaseDF() + ":LastFitProfile")
    Make/O/D/N=0 $(LJZ_HStripe_BaseDF() + ":LastCorrectionProfile")
    Make/O/D/N=0 $(LJZ_HStripe_BaseDF() + ":LastStripeProfile")

    Wave profile = $(LJZ_HStripe_BaseDF() + ":LastProfile")
    Wave fitProfile = $(LJZ_HStripe_BaseDF() + ":LastFitProfile")
    Wave corrProfile = $(LJZ_HStripe_BaseDF() + ":LastCorrectionProfile")
    Wave stripeProfile = $(LJZ_HStripe_BaseDF() + ":LastStripeProfile")

    for (layer = 0; layer < nLayer; layer += 1)
        if (mode == 5)
            LJZ_HStripe_ApplyMDCWiseCorrection(src, dest, layer, axis, effLo, effHi, LineSmoothPts, MDCAlpha, StripeLimitFactor, LayerNormMode)
            continue
        endif

        if (mode == 4)
            LJZ_HStripe_ApplyLineHighpass(src, dest, layer, axis, effLo, effHi, LineSmoothPts)
            continue
        endif

        LJZ_HStripe_MakeProfileFromLayer(src, profile, layer, axis, avgLo, avgHi)

        Duplicate/O profile, fitProfile
        LJZ_HStripe_FillBoundary(fitProfile, effLo, effHi)

        Smooth/BLPF cutoff, fitProfile

        LJZ_HStripe_FillBoundary(fitProfile, effLo, effHi)

        Duplicate/O profile, corrProfile
        corrProfile = profile[p] / fitProfile[p]
        LJZ_HStripe_FillBoundary(corrProfile, effLo, effHi)
        LJZ_HStripe_CleanAndLimitCorrection(corrProfile, CorrMin, CorrMax)

        Duplicate/O profile, stripeProfile
        stripeProfile = profile[p] - fitProfile[p]
        LJZ_HStripe_FillBoundary(stripeProfile, effLo, effHi)
        LJZ_HStripe_LimitStripe(stripeProfile, StripeLimitFactor)

        if (EdgeSmooth > 1)
            Smooth EdgeSmooth, corrProfile
            Smooth EdgeSmooth, stripeProfile
        endif

        LJZ_HStripe_ApplyProfileCorrection(src, dest, layer, axis, mode, corrProfile, stripeProfile, CorrectionPower, effLo, effHi)
    endfor

    showLayer = nLayer - 1
    LJZ_HStripe_MakeLastLayerImages(src, dest, showLayer)

    Note/K dest
    String noteStr
    noteStr = ""
    noteStr += "LJZ_HStripeRemove\r"
    noteStr += "Source=" + wPath + "\r"
    noteStr += "StripeAxis=" + num2str(axis) + "\r"
    noteStr += "CorrectionMode=" + num2str(mode) + "\r"
    noteStr += "AvgPointRange=" + num2str(avgLo) + " to " + num2str(avgHi) + "\r"
    noteStr += "EffectivePointRange=" + num2str(effLo) + " to " + num2str(effHi) + "\r"
    noteStr += "SmoothCutoff=" + num2str(cutoff) + "\r"
    noteStr += "LineSmoothPts=" + num2str(LineSmoothPts) + "\r"
    noteStr += "MDCAlpha=" + num2str(MDCAlpha) + "\r"
    noteStr += "LayerNormMode=" + num2str(LayerNormMode) + "\r"
    Note dest, noteStr

    SetDataFolder oldDF

    Print "LJZ_HStripeRemove: output = " + outPath
    Print "  StripeAxis = ", axis, " CorrectionMode = ", mode, " LastLayer = ", showLayer

    if (showChecks)
        LJZ_HStripe_ShowCheckGraphs()
    endif

    return 0
End

Function LJZ_HStripe_ProcessSelected()
    LJZ_HStripe_EnsureDF()

    SVAR sWave = $(LJZ_HStripe_BaseDF() + ":WaveSel")

    if (strlen(sWave) == 0)
        DoAlert 0, "Please select a 2D/3D wave first."
        return -1
    endif

    return LJZ_HStripe_ProcessWave(sWave, 1)
End

Function LJZ_HStripe_ProcessAll()
    LJZ_HStripe_EnsureDF()

    String listStr
    Variable n
    Variable i
    Variable okCount

    listStr = LJZ_HStripe_CurrentWaveList()
    n = ItemsInList(listStr, ";")

    if (n <= 0)
        DoAlert 0, "No 2D/3D numeric waves found in SourceDF."
        return -1
    endif

    okCount = 0

    for (i = 0; i < n; i += 1)
        String wPath = StringFromList(i, listStr, ";")
        Print "HStripeRemove: processing " + num2str(i + 1) + " / " + num2str(n) + " : " + wPath
        if (LJZ_HStripe_ProcessWave(wPath, 0) == 0)
            okCount += 1
        endif
        DoUpdate
    endfor

    LJZ_HStripe_ShowCheckGraphs()

    Print "HStripeRemove: finished. success = ", okCount, " / ", n

    return 0
End

Function LJZ_HStripe_ResetDefaults2()
    LJZ_HStripe_EnsureDF()

    NVAR StripeAxis = $(LJZ_HStripe_BaseDF() + ":StripeAxis")
    NVAR AvgStart = $(LJZ_HStripe_BaseDF() + ":AvgStart")
    NVAR AvgEnd = $(LJZ_HStripe_BaseDF() + ":AvgEnd")
    NVAR EffStart = $(LJZ_HStripe_BaseDF() + ":EffStart")
    NVAR EffEnd = $(LJZ_HStripe_BaseDF() + ":EffEnd")
    NVAR SmoothCutoff = $(LJZ_HStripe_BaseDF() + ":SmoothCutoff")
