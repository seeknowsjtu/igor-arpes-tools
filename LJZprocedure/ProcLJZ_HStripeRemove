Function LJZ_HStripe_ShowCheckGraphs()
    LJZ_HStripe_EnsureDF()

    Wave/Z raw2D = $(LJZ_HStripe_BaseDF() + ":LastRaw2D")
    Wave/Z cor2D = $(LJZ_HStripe_BaseDF() + ":LastCorrected2D")
    Wave/Z profile = $(LJZ_HStripe_BaseDF() + ":LastProfile")
    Wave/Z fitProfile = $(LJZ_HStripe_BaseDF() + ":LastFitProfile")
    Wave/Z corrProfile = $(LJZ_HStripe_BaseDF() + ":LastCorrectionProfile")
    Wave/Z stripeProfile = $(LJZ_HStripe_BaseDF() + ":LastStripeProfile")

    String gName
    String rawName
    String corName
    String pName
    String fitName
    String stripeName
    String corrName

    if (WaveExists(raw2D))
        rawName = NameOfWave(raw2D)
        gName = "LJZ_HStripe_Check_RawImage"
        DoWindow/K $gName
        Display/N=$gName
        AppendImage/W=$gName raw2D
        ModifyImage/W=$gName $rawName, ctab={*,*,Grays,0}
        ModifyGraph/W=$gName margin(left)=45, margin(bottom)=38
        TextBox/W=$gName/C/N=text0/A=LT "raw image"
    endif

    if (WaveExists(cor2D))
        corName = NameOfWave(cor2D)
        gName = "LJZ_HStripe_Check_CorrectedImage"
        DoWindow/K $gName
        Display/N=$gName
        AppendImage/W=$gName cor2D
        ModifyImage/W=$gName $corName, ctab={*,*,Grays,0}
        ModifyGraph/W=$gName margin(left)=45, margin(bottom)=38
        TextBox/W=$gName/C/N=text0/A=LT "corrected image"
    endif

    if (WaveExists(profile) && WaveExists(fitProfile))
        if (numpnts(profile) > 0 && numpnts(fitProfile) > 0)
            pName = NameOfWave(profile)
            fitName = NameOfWave(fitProfile)

            gName = "LJZ_HStripe_Check_Profile"
            DoWindow/K $gName
            Display/N=$gName profile
            AppendToGraph/W=$gName fitProfile
            ModifyGraph/W=$gName lsize($pName)=1
            ModifyGraph/W=$gName lsize($fitName)=2
            Label/W=$gName bottom "stripe axis coordinate"
            Label/W=$gName left "profile intensity"
            Legend/W=$gName/C/N=text0/J/A=LT "\s(" + pName + ") profile(" + fitName + ") BLPF background"
        endif
    endif

    if (WaveExists(stripeProfile) && WaveExists(corrProfile))
        if (numpnts(stripeProfile) > 0 && numpnts(corrProfile) > 0)
            stripeName = NameOfWave(stripeProfile)
            corrName = NameOfWave(corrProfile)

            gName = "LJZ_HStripe_Check_Stripe"
            DoWindow/K $gName
            Display/N=$gName stripeProfile
            AppendToGraph/W=$gName/R corrProfile
            ModifyGraph/W=$gName lsize($stripeName)=2
            ModifyGraph/W=$gName lsize($corrName)=1
            Label/W=$gName bottom "stripe axis coordinate"
            Label/W=$gName left "additive stripe"
            Label/W=$gName right "multiplicative correction"
            Legend/W=$gName/C/N=text0/J/A=LT "\s(" + stripeName + ") stripe(" + corrName + ") correction"
        endif
    endif

    return 0
End

Function LJZ_HStripe_RefreshTitleBoxes()
    String p

    p = LJZ_HStripe_PanelName()
    DoWindow $p
    if (!V_flag)
        return 0
    endif

    SVAR sWave = $(LJZ_HStripe_BaseDF() + ":WaveSel")
    NVAR StripeAxis = $(LJZ_HStripe_BaseDF() + ":StripeAxis")
    NVAR CorrectionMode = $(LJZ_HStripe_BaseDF() + ":CorrectionMode")

    String modeText
    if (round(CorrectionMode) == 1)
        modeText = "Mode 1 Additive"
    elseif (round(CorrectionMode) == 2)
        modeText = "Mode 2 Multiplicative"
    elseif (round(CorrectionMode) == 3)
        modeText = "Mode 3 Weak division"
    elseif (round(CorrectionMode) == 4)
        modeText = "Mode 4 Line high-pass"
    else
        modeText = "Mode 5 MDC-wise"
    endif

    TitleBox tbSelected, win=$p, title="Selected: " + LJZ_HStripe_ShortenForTitle(sWave, 82)
    TitleBox tbStatus, win=$p, title="Axis=" + num2str(round(StripeAxis)) + "   " + modeText

    return 0
End


